# Local development only. Copy to .env (git-ignored). Real values live in Cloudflare secrets,
# GitHub Actions secrets and Supabase vault — never in the repository.

# --- Panel (apps/web/.env.local) — browser-safe values only ---
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
VITE_ALLOWED_EMAIL=
# Worker base URL (panel actions, demo links), e.g. https://papi-api.<sub>.workers.dev
VITE_API_URL=

# --- Worker (apps/api/.dev.vars) ---
APP_ENV=development
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# --- GitHub Actions secrets (names only; set in repo settings) ---
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_DB_PASSWORD=
# SUPABASE_PROJECT_REF=

# --- Worker secrets (apps/api/.dev.vars locally; GitHub secrets → synced by the API deploy workflow) ---
# TENANT_ID=                   # optional, defaults to the AJNA tenant
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=     # random string, e.g. `openssl rand -hex 32`
# TELEGRAM_OWNER_ID=           # Timurhan's numeric Telegram user id
# GEMINI_API_KEY=
# GROQ_API_KEY=
# ANTHROPIC_API_KEY=           # off by default (feature flag adapter_anthropic)
# PAGESPEED_API_KEY=           # optional, PageSpeed Insights
# PANEL_URL=                   # panel base URL for links in Telegram cards
# IG_BUSINESS_ACCOUNT_ID=      # optional, Instagram business discovery
# IG_ACCESS_TOKEN=
# GITHUB_DISPATCH_TOKEN=       # optional, starts the heavy-jobs workflow immediately
# GITHUB_REPOSITORY=           # owner/repo, set automatically by the deploy workflow
# PUBLIC_API_URL=              # Worker's public base URL (unsubscribe links), e.g. https://papi-api.<sub>.workers.dev
# PUBLIC_TOKEN_SECRET=         # >= 32 chars, signs unsubscribe tokens: `openssl rand -hex 32`
# GOOGLE_CLIENT_ID=            # Google Calendar (optional): OAuth web client
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=        # from OAuth Playground, scopes calendar.events + calendar.freebusy
# GOOGLE_CALENDAR_ID=          # optional, defaults to primary
# TURNSTILE_SITE_KEY=          # Cloudflare Turnstile for demo pages (required in production)
# TURNSTILE_SECRET_KEY=

# --- GitHub Actions secrets for API deploy ---
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=   # Supabase "secret key" — server side only, never in the panel
